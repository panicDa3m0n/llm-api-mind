{
  "name": "llm-api-mind-frontend",
  "private": true,
  "version": "1.58.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:vps": "tsc -b && vite build --mode vps",
    "build:android": "tsc -b && vite build --mode android && cap sync android",
    "android:debug": "npm run build:android && node scripts/build-android.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:prototype:ui": "node scripts/test-product-ui.mjs",
    "avatar:parts": "node scripts/prepare-scarlet-anatomical-part.mjs",
    "avatar:reference:audit": "node scripts/analyze-avatar-psd-reference.mjs",
    "avatar:rig-psd": "node scripts/build-scarlet-rig-psd.mjs",
    "avatar:rig-workspace": "npm run avatar:parts && npm run avatar:rig-psd"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/device": "^7.0.5",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/motion": "^7.0.3",
    "@capacitor/network": "^7.0.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "ag-psd": "^31.0.2",
    "playwright-core": "1.61.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }

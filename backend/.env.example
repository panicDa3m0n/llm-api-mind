APP_NAME=LLM API Mind
ENVIRONMENT=local
LOG_LEVEL=INFO

LLM_PROVIDER=minimax

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MAX_TOKENS=131072
# Non-Scarlet semantic workers and validators always use this MiniMax profile.
# Scarlet herself, including autonomous activations, continues to use M3.
AUXILIARY_MINIMAX_MODEL=MiniMax-M2.7
AUXILIARY_MINIMAX_MAX_TOKENS=131072
# Retry transient provider streams and continue complete max_tokens segments.
PROVIDER_STREAM_MAX_ATTEMPTS=5
PROVIDER_STREAM_RETRY_BACKOFF_SECONDS=0.5
PROVIDER_MAX_TOKEN_CONTINUATIONS=8

# Traceable semantic answer control. Native finality comes from end_turn;
# `active` enforces hard obligations for conflicts, evidence, capabilities, and
# failed actions. `shadow` evaluates without blocking; `off` disables it.
ANSWER_OBLIGATIONS_MODE=active
ANSWER_VALIDATION_MAX_TOKENS=4096

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/apps/anthropic
QWEN_MODEL=qwen3.7-max
QWEN_MAX_TOKENS=4096

# Optional. Leave empty to use backend/app/prompts/scarlet_system.md.
AGENT_SYSTEM_PROMPT=
AGENT_SYSTEM_PROMPT_PATH=

DATABASE_URL=sqlite:///./data/app.db

# `auto` resolves local/development to `laboratory`, test to `test`, and
# production to `production`. Nonstandard environments such as the VPS mobile
# preview must set this explicitly so database ownership is never guessed.
DATABASE_ROLE=auto

# Codex/evaluator isolation mode. When enabled, the backend opens the Codex
# test database instead of the production/lab database. If the test database
# file does not exist yet, it is seeded once from DATABASE_URL (or from
# CODEX_TEST_SEED_DATABASE_URL when provided).
CODEX_TEST=false
CODEX_TEST_DATABASE_URL=sqlite:///./data/codex_test.db
CODEX_TEST_SEED_DATABASE_URL=

# Backend-owned idle maintenance. After a completed Scarlet turn, the backend
# schedules one per-session job that is superseded if another turn arrives.
MAINTENANCE_ENABLED=true
AUTONOMOUS_ACTIVATION_ENABLED=true
# Current observation cadence. Reassess after measuring behavioral value and cost.
AUTONOMOUS_ACTIVATION_INTERVAL_SECONDS=600
AUTONOMOUS_ACTIVATION_WORKER_INTERVAL_SECONDS=5
AUTONOMOUS_ACTIVATION_LEASE_SECONDS=900
AUTONOMOUS_ACTIVATION_DEFER_SECONDS=60
AUTONOMOUS_ACTIVATION_HUMAN_TURN_FRESHNESS_SECONDS=21600
AUTONOMOUS_ACTIVATION_BATCH_SIZE=1
AUTONOMOUS_ACTIVATION_PERCEPTION_CHANNEL_LIMIT=20
# Cognitive Workspace admission. `active` replaces periodic wakes with
# event/condition ignition plus a bounded watchdog. `shadow` records M2.7
# appraisal/arbitration without scheduling Scarlet and is also the only
# historical replay mode; `advisory` attaches work to a periodic activation.
COGNITIVE_WORKSPACE_MODE=active
COGNITIVE_WORKSPACE_SIGNAL_BATCH_SIZE=100
COGNITIVE_WORKSPACE_APPRAISAL_BATCH_SIZE=20
COGNITIVE_WORKSPACE_CANDIDATE_POOL_LIMIT=20
COGNITIVE_WORKSPACE_APPRAISAL_MAX_TOKENS=8192
COGNITIVE_WORKSPACE_ARBITRATION_MAX_TOKENS=8192
COGNITIVE_WORKSPACE_MAX_DEFERRALS=3
COGNITIVE_WORKSPACE_WATCHDOG_SECONDS=3600
# Adaptive free cognitive windows. M2.7 may propose source-backed seeds;
# only an actual Scarlet M3 activation can endorse or reject them.
ENDOGENOUS_COGNITION_ENABLED=true
ENDOGENOUS_COGNITION_MIN_INTERVAL_SECONDS=900
ENDOGENOUS_COGNITION_BASE_INTERVAL_SECONDS=3600
ENDOGENOUS_COGNITION_MAX_INTERVAL_SECONDS=21600
ENDOGENOUS_COGNITION_PRODUCTIVE_FOLLOWUP_SECONDS=1800
ENDOGENOUS_COGNITION_MAX_SEEDS=4
ENDOGENOUS_COGNITION_MAX_TOKENS=8192
# `active` derives only bounded transitions into the perception inbox. Raw
# Device Exploration evidence remains separate and is never auto-injected.
DEVICE_PERCEPTION_ADMISSION_MODE=active
MAINTENANCE_IDLE_SECONDS=900
MAINTENANCE_WORKER_INTERVAL_SECONDS=5
MAINTENANCE_JOB_BATCH_SIZE=5

# Native model-input accounting and chronological compaction policy. Use
# `shadow` for planning only or `active` for recursive derived history. Both
# preserve canonical history. Recent-turn selection is token-based; the legacy
# turn-count value is retained only for environment compatibility.
CONTEXT_WINDOW_TOKENS=1000000
CONTEXT_OPERATIONAL_INPUT_LIMIT_TOKENS=500000
CONTEXT_COMPACTION_TRIGGER_TOKENS=400000
HISTORY_COMPACTION_TARGET_TOKENS=100000
HISTORY_COMPACTION_VERBATIM_TOKENS=100000
HISTORY_COMPACTION_SAFETY_TOKENS=25000
HISTORY_COMPACTION_RECENT_TURNS=8
HISTORY_COMPACTION_MODE=shadow
CONTEXT_ESTIMATED_CHARS_PER_TOKEN=3.5

# Optional retrieval shadow mode. Disabled by default; use `local` for
# deterministic plumbing tests, `milvus_lite` after installing
# `pymilvus[milvus-lite]`, or `openrouter` for cloud embedding shadow.
RETRIEVAL_SHADOW_ENABLED=false
RETRIEVAL_SHADOW_BACKEND=none
RETRIEVAL_SHADOW_TOP_K=10
RETRIEVAL_SHADOW_VECTOR_DIM=2048
RETRIEVAL_SHADOW_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
RETRIEVAL_SHADOW_CLOUD_SURFACE_LIMIT=50
RETRIEVAL_SHADOW_HTTP_TIMEOUT_SECONDS=30
RETRIEVAL_SHADOW_RERANK_ENABLED=false
RETRIEVAL_SHADOW_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RETRIEVAL_SHADOW_RERANK_CANDIDATE_LIMIT=20
RETRIEVAL_SHADOW_RERANK_TOP_N=10

# Retrieval relevance policy. `off` preserves the deterministic legacy
# baseline, `shadow` observes the memory-level reranker without changing
# selection, and `active` makes the reranker the sole final relevance arbiter.
# Active mode fails closed if reranking is unavailable; sparse, dense, KG, and
# lexical signals only build the candidate pool.
RETRIEVAL_HYBRID_MODE=off
RETRIEVAL_HYBRID_MIN_DENSE_SCORE=0.38
# Provisional live-calibrated acceptance threshold. Keep measuring it against
# positive and negative full-DB controls before treating it as stable.
RETRIEVAL_HYBRID_MIN_RERANK_SCORE=0.004
RETRIEVAL_HYBRID_RELATIVE_RERANK_FLOOR=0.01
# Deprecated compatibility values; V1.31 active retrieval does not use them.
RETRIEVAL_HYBRID_BASE_WEIGHT=0.35
RETRIEVAL_HYBRID_SPARSE_WEIGHT=0.15
RETRIEVAL_HYBRID_DENSE_WEIGHT=0.35
RETRIEVAL_HYBRID_RERANK_WEIGHT=0.20
# Deprecated legacy audit weights. Active ranking ignores stored memory
# confidence/salience and computes relevance dynamically per query.
RETRIEVAL_HYBRID_SALIENCE_WEIGHT=0.0
RETRIEVAL_HYBRID_CONFIDENCE_WEIGHT=0.0
MILVUS_LITE_URI=./data/milvus_lite_shadow.db
MILVUS_COLLECTION=memory_surfaces_shadow

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Metacognitive context experiment. `shadow` records and shows candidate
# lessons without sending them to the model. Use `inject` only for controlled
# A/B tests.
METACOGNITIVE_CONTEXT_MODE=shadow
METACOGNITIVE_CONTEXT_MAX_LESSONS=3

# Digital-individual organ substrate. Keep `off` until the corresponding organ
# is implemented and verified. Supported modes are: off, shadow, model, manual,
# autonomous_only. These flags do not enable behavior by themselves; they are
# the governance switches used by future focused slices.
ORGAN_FOCUS_MODE=off
ORGAN_VOLITION_MODE=off
ORGAN_AFFECT_MODE=off
ORGAN_TEMPORAL_EXPERIENCE_MODE=off
ORGAN_DREAM_MODE=off

# Dashboard/runtime defaults. Persisted dashboard settings override these.
RUNTIME_TIMEZONE=Europe/Rome
RUNTIME_LANGUAGE=it
RUNTIME_LANGUAGE_LABEL=Italiano
RUNTIME_COUNTRY_CODE=IT
RUNTIME_COUNTRY_LABEL=Italia
USER_PROFILE_ID=local-user
USER_DISPLAY_NAME=Utente locale
USER_PRIVACY_SCOPE=local_single_user

# External ChatGPT GPT Actions bridge. Required when ENVIRONMENT is not local.
# Requests may use Authorization: Bearer <key> or X-GPT-Bridge-Key: <key>.
GPT_BRIDGE_API_KEY=
